# Agentic AI Software Company - environment template
# Copy this file to `.env` and adapt it to your environment.
# Never commit real secrets to GitHub.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Examples:
#   ollama  -> local Ollama installation
#   openai  -> OpenAI-compatible endpoint, e.g. HAW ICC if provided that way
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b

# When Python/FastAPI runs directly on the host:
LLM_BASE_URL=http://localhost:11434

# If the application runs inside Docker while Ollama runs natively on
# macOS/Windows, use instead:
# LLM_BASE_URL=http://host.docker.internal:11434
#
# For HAW ICC, replace this with the provided API base URL.
LLM_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings / RAG
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_company
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic

DATABASE_URL=postgresql+psycopg://agentic:agentic@localhost:5432/agentic_company

# If FastAPI runs inside Docker Compose and PostgreSQL is the service `db`:
# POSTGRES_HOST=db
# DATABASE_URL=postgresql+psycopg://agentic:agentic@db:5432/agentic_company

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Local tracing / cost engineering
# -----------------------------------------------------------------------------
TRACE_DIR=logs/traces
COST_LOG_PATH=costs/usage.csv

# -----------------------------------------------------------------------------
# Optional LangSmith tracing
# -----------------------------------------------------------------------------
# LangSmith is optional and does not replace local repository-based traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-course

# Optional endpoint override:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
